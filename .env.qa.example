# ─────────────────────────────────────────────────────────────────────────────
# .env.qa.example — ALCOP QA / Demo (Coolify)
#
# Copiar estos valores a la UI de Coolify (Environment Variables) del recurso
# Docker Compose. NO commitear el .env.qa real con valores reales (está en
# .gitignore). Aquí solo van placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Postgres del compose) ─────────────────────────────────────
DB_USER=alcop_qa
DB_PASSWORD=cambiar_password_fuerte
DB_NAME=alcop_qa

# ── Redis del compose ────────────────────────────────────────────────────────
REDIS_PASSWORD=cambiar_redis_password_fuerte

# ── Auth ─────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres (lo valida env.ts con Zod al arrancar).
BETTER_AUTH_SECRET=generar_secreto_de_al_menos_32_caracteres_aqui

# ── URLs públicas (las asigna Coolify al crear los dominios) ─────────────────
# API_PUBLIC_URL  → dominio del servicio `api`  (→ BETTER_AUTH_URL)
# WEB_PUBLIC_URL  → dominio del servicio `web`  (→ CORS_ORIGIN y NEXT_PUBLIC_APP_URL)
# Rellenar DESPUÉS de que Coolify genere los subdominios, luego redeploy.
API_PUBLIC_URL=https://REEMPLAZAR-api.sslip-o-coolify.host
WEB_PUBLIC_URL=https://REEMPLAZAR-web.sslip-o-coolify.host

# ── Build arg del web (se embebe en el bundle del navegador) ─────────────────
# Es API_PUBLIC_URL + "/api". Si cambia, hay que REBUILD del web (no basta redeploy).
NEXT_PUBLIC_API_URL=https://REEMPLAZAR-api.sslip-o-coolify.host/api

# ── Email (opcional en Etapa 1 — notificaciones por obra, pendiente de spec) ──
EMAIL_FROM=noreply@alcop.cl
RESEND_API_KEY=

# ── Análisis IA (mock hasta tener la API key de Gemini de ALCOP) ─────────────
AI_PROVIDER=mock
AI_API_KEY=

# ── Admin sembrado (seed corre en el arranque de la API vía Dockerfile CMD) ──
# SIN SEED_ADMIN_PASSWORD el seed NO crea ni rota el admin (no hay credencial por
# defecto en el repo). Definir un valor fuerte (>=8). Cambiar esta variable y
# redeployar rota la contraseña del admin existente de forma idempotente.
SEED_ADMIN_EMAIL=admin@alcop.cl
SEED_ADMIN_PASSWORD=generar_password_fuerte_para_el_admin
