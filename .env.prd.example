# ─────────────────────────────────────────────────────────────────────────────
# .env.prd.example — ALCOP PRODUCCIÓN en Coolify, 4 recursos SEPARADOS:
#   alcop-prd-db (PostgreSQL 17) · alcop-prd-redis (Redis 7) · alcop-prd-api · alcop-prd-web
# Solo placeholders. Secretos: openssl rand -base64 36
# Ver deploy/prd/MIGRACION-PRD.md §3.
# ─────────────────────────────────────────────────────────────────────────────

# ══ alcop-prd-db (Database → PostgreSQL 17) ══ se define en la UI del recurso
#   Username: alcop_prd · Database: alcop_prd · Password: <generada>
#   Make it publicly available: NO (ver runbook §6 para acceso pgAdmin/BI)

# ══ alcop-prd-redis (Database → Redis 7) ══ password la genera Coolify

# ══ alcop-prd-api (Application → Dockerfile, base dir /alcop-api, puerto 3001) ══
NODE_ENV=production
PORT=3001
TZ=America/Santiago
# Copiar "Postgres URL (internal)" del recurso db, cambiando la BD al nombre real:
DATABASE_URL=postgresql://alcop_prd:<PASS>@<UUID-DB>:5432/alcop_prd
# Copiar "Redis URL (internal)" del recurso redis:
REDIS_URL=redis://default:<PASS>@<UUID-REDIS>:6379
# >= 32 chars. NUEVO (no reutilizar el de QA).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.alcop.cl
API_BASE_URL=https://api.alcop.cl
CORS_ORIGIN=https://app.alcop.cl
EMAIL_FROM=noreply@alcop.cl
RESEND_API_KEY=
AI_PROVIDER=mock
AI_API_KEY=
# PRD: SIN seed. Los datos (incluidos usuarios/admin) vienen migrados de QA.
# Solo migraciones de esquema (prisma migrate deploy) en cada deploy.
SEED_ON_START=false

# ══ alcop-prd-web (Application → Dockerfile, base dir /alcop-web, puerto 3000) ══
# Ambas marcadas como "Build Variable" en Coolify (se embeben en el bundle al compilar).
# Si cambian → REBUILD del web (y nuevo build EAS de la app móvil para la URL de la API).
NEXT_PUBLIC_API_URL=https://api.alcop.cl/api
NEXT_PUBLIC_APP_URL=https://app.alcop.cl
