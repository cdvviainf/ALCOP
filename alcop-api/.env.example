# App
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3011

# Database (PostgreSQL 17 — ver docker-compose.yml, puerto 5434)
DATABASE_URL=postgresql://alcop_user:alcop_pass@localhost:5434/alcop_db

# Redis (puerto 6380)
REDIS_URL=redis://:<redis_pass>@localhost:6380

# Auth (Better Auth) — el secreto debe tener al menos 32 caracteres
BETTER_AUTH_SECRET=<generar_un_secreto_de_32+_caracteres>
BETTER_AUTH_URL=http://localhost:3011

# Email (Resend o SMTP propio de ALCOP)
RESEND_API_KEY=
EMAIL_FROM=noreply@alcop.cl

# Análisis IA — mock hasta tener la API key de Gemini de ALCOP
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# AI_API_KEY=

# CORS (frontend alcop-web)
CORS_ORIGIN=http://localhost:3010

# Motor de Documentos (PDF) — Playwright / Chromium del sistema
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium-browser
