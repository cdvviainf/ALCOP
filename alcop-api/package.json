{
  "name": "alcop-api",
  "version": "1.0.0",
  "description": "ALCOP — Sistema de Inspección en Terreno · Backend (Fastify + TypeScript + Prisma)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "VIAIN Asesorías Informáticas",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "playwright": "^1.63.0",
    "prisma": "^5.22.0",
    "resend": "^6.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
