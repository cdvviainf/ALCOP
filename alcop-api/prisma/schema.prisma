generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NivelAcceso {
  SIN_ACCESO
  LECTURA
  TOTAL
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Tablas propias de Better Auth (identidad y credenciales). El dominio vive en
// `Usuario`, que se enlaza por `Usuario.authUserId → User.id`. En ALCOP el id de
// dominio de Usuario YA es String (cuid), pero sigue siendo una tabla distinta:
// Better Auth gestiona email/password/sesión; `Usuario` gestiona perfil/área.
// No se editan a mano (nombres de campo estándar de Better Auth).

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

enum RolObra {
  ADMINISTRADOR
  JEFE_DE_TERRENO
  PREVENCIONISTA
}

enum TipoRespuesta {
  CHECKBOX
  SELECCION_MULTIPLE
  NUMERO
  TEXTO
  TEXTO_LARGO
}

model Area {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique // "PREVENCION" | "TECNICA"
  nombre      String
  categorias  CategoriaFormulario[]
  formularios Formulario[]
}

model Usuario {
  id          String   @id @default(cuid()) // String — referencia Better Auth
  // Enlace 1:1 con la identidad de Better Auth (auth_user.id). Nullable: un
  // Usuario puede existir sin credencial todavía; sin authUserId no autentica.
  // Columna + @unique (sin navegación de relación: el guard hace findFirst).
  authUserId  String?  @unique
  nombre      String
  email       String   @unique
  activo      Boolean  @default(true)
  perfilId    Int
  perfil      Perfil   @relation(fields: [perfilId], references: [id])
  obras       UsuarioObra[]
  respuestas  RespuestaFormulario[]
  permisos    FormularioPermiso[]
  creadoEn    DateTime @default(now())
  creadoPor   String?
  eliminadoEn DateTime?
}

model Perfil {
  id              Int         @id @default(autoincrement())
  nombre          String
  nivelPrevencion NivelAcceso @default(SIN_ACCESO)
  nivelTecnica    NivelAcceso @default(SIN_ACCESO)
  usuarios        Usuario[]
  creadoEn        DateTime    @default(now())
  eliminadoEn     DateTime?
}

model UsuarioObra {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  obraId    Int
  obra      Obra     @relation(fields: [obraId], references: [id])
  rolObra   RolObra
  creadoEn  DateTime @default(now())

  @@unique([obraId, rolObra])
}

// Obra es MÍNIMA y PROVISIONAL — el spec nucleo-compartido.md está pendiente.
// Campos según Docs/00-mantenedores-requeridos.md #10.
model Obra {
  id          Int      @id @default(autoincrement())
  nombre      String
  // `comuna` lo muestra el mockup "Tus obras". Obra sigue PROVISIONAL hasta el
  // spec nucleo-compartido.md; no agregar más campos sin ese spec.
  comuna      String?
  direccion   String?
  activo      Boolean  @default(true)
  fechaInicio DateTime?
  usuarios    UsuarioObra[]
  respuestas  RespuestaFormulario[]
  creadoEn    DateTime @default(now())
  creadoPor   String?
  eliminadoEn DateTime?
}

model CategoriaFormulario {
  id          Int          @id @default(autoincrement())
  areaId      Int
  area        Area         @relation(fields: [areaId], references: [id])
  codigo      String
  nombre      String
  formularios Formulario[]
}

model Formulario {
  id           Int      @id @default(autoincrement())
  codigo       String   @unique
  nombre       String
  areaId       Int
  area         Area     @relation(fields: [areaId], references: [id])
  categoriaId  Int
  categoria    CategoriaFormulario @relation(fields: [categoriaId], references: [id])
  requiereObra Boolean  @default(true)
  activo       Boolean  @default(true)
  preguntas    Pregunta[]
  permisos     FormularioPermiso[]
  respuestas   RespuestaFormulario[]
  creadoEn     DateTime @default(now())
  creadoPor    String
  eliminadoEn  DateTime?
}

model Pregunta {
  id            Int      @id @default(autoincrement())
  formularioId  Int
  formulario    Formulario @relation(fields: [formularioId], references: [id])
  orden         Int
  texto         String
  tipoRespuesta TipoRespuesta
  obligatoria   Boolean  @default(true)
  permiteFoto   Boolean  @default(false)
  opciones      String[]
  respuestas    RespuestaPregunta[]
}

model RespuestaFormulario {
  id           Int      @id @default(autoincrement())
  formularioId Int
  formulario   Formulario @relation(fields: [formularioId], references: [id])
  obraId       Int
  obra         Obra     @relation(fields: [obraId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  fechaHora    DateTime @default(now())
  respuestas   RespuestaPregunta[]
  creadoEn     DateTime @default(now())
}

model RespuestaPregunta {
  id                     Int      @id @default(autoincrement())
  respuestaFormularioId  Int
  respuestaFormulario    RespuestaFormulario @relation(fields: [respuestaFormularioId], references: [id])
  preguntaId             Int
  pregunta               Pregunta @relation(fields: [preguntaId], references: [id])
  valorTexto             String?
  valorNumero            Decimal?
  valorCheckbox          String?
  valorSeleccionMultiple String[]
  fotoUrl                String?
}

model FormularioPermiso {
  id           Int      @id @default(autoincrement())
  formularioId Int
  formulario   Formulario @relation(fields: [formularioId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  puedeVer     Boolean  @default(true)
  puedeEditar  Boolean  @default(false)

  @@unique([formularioId, usuarioId])
}
