generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NivelAcceso {
  SIN_ACCESO
  LECTURA
  TOTAL
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Tablas propias de Better Auth (identidad y credenciales). El dominio vive en
// `Usuario`, que se enlaza por `Usuario.authUserId → User.id`. En ALCOP el id de
// dominio de Usuario YA es String (cuid), pero sigue siendo una tabla distinta:
// Better Auth gestiona email/password/sesión; `Usuario` gestiona perfil/área.
// No se editan a mano (nombres de campo estándar de Better Auth).

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

enum RolObra {
  ADMINISTRADOR
  JEFE_DE_TERRENO
  PREVENCIONISTA
}

enum EstadoObra {
  SIN_INICIAR
  EN_EJECUCION
  SUSPENDIDA
  TERMINADA
}

enum TipoRespuesta {
  CHECKBOX
  SELECCION_MULTIPLE
  NUMERO
  TEXTO
  TEXTO_LARGO
}

model Area {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique // "PREVENCION" | "TECNICA"
  nombre      String
  categorias  CategoriaFormulario[]
  formularios Formulario[]
}

model Usuario {
  id          String   @id @default(cuid()) // String — referencia Better Auth
  // Enlace 1:1 con la identidad de Better Auth (auth_user.id). Nullable: un
  // Usuario puede existir sin credencial todavía; sin authUserId no autentica.
  // Columna + @unique (sin navegación de relación: el guard hace findFirst).
  authUserId  String?  @unique
  nombre      String
  email       String   @unique
  activo      Boolean  @default(true)
  // Administrador transversal (acceso TOTAL a todo; el perfil se ignora).
  esAdmin     Boolean  @default(false)
  perfilId    Int?
  perfil      Perfil?  @relation(fields: [perfilId], references: [id])
  obras       UsuarioObra[]
  titularidades ObraTitular[]
  respuestas  RespuestaFormulario[]
  permisos    FormularioPermiso[]
  visitas     VisitaTecnica[]
  visitasPrevencion VisitaPrevencion[]
  creadoEn    DateTime @default(now())
  creadoPor   String?
  eliminadoEn DateTime?
}

// Modelo de accesos granular (Docs/usuarios-perfiles.md §4/§6, v2 07-10-2026).
model Perfil {
  id             Int             @id @default(autoincrement())
  nombre         String
  areaPrevencion Boolean         @default(false)
  areaTecnica    Boolean         @default(false)
  permisos       PerfilPermiso[]
  usuarios       Usuario[]
  creadoEn       DateTime        @default(now())
  eliminadoEn    DateTime?
}

enum FuncionArea {
  TRANSVERSAL
  PREVENCION
  TECNICA
}

// Catálogo de funciones/mantenedores controlables por perfil.
model Funcion {
  id       Int             @id @default(autoincrement())
  codigo   String          @unique
  nombre   String
  area     FuncionArea
  orden    Int             @default(0)
  permisos PerfilPermiso[]
}

// Nivel de un Perfil sobre una Función. Si el Área está apagada en el perfil, el
// nivel efectivo es SIN_ACCESO (se resuelve en la autorización, no acá).
model PerfilPermiso {
  id        Int         @id @default(autoincrement())
  perfilId  Int
  perfil    Perfil      @relation(fields: [perfilId], references: [id])
  funcionId Int
  funcion   Funcion     @relation(fields: [funcionId], references: [id])
  nivel     NivelAcceso @default(SIN_ACCESO)

  @@unique([perfilId, funcionId])
}

// Asignación de titulares de obra (nucleo-compartido.md §4). Varios usuarios por
// rol; un usuario puede tener más de un rol. El @@unique evita duplicar la misma
// persona en el mismo rol de la misma obra.
// Acceso de un usuario a una obra (22-10-2026). Es la pertenencia pura usuario↔obra,
// SIN rol: los roles viven en ObraTitular y se eligen solo entre quienes tienen acceso.
// Unicidad (obraId, usuarioId) entre las vivas → índice único PARCIAL en la migración.
model UsuarioObra {
  id             Int       @id @default(autoincrement())
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  obraId         Int
  obra           Obra      @relation(fields: [obraId], references: [id])
  creadoEn       DateTime  @default(now())
  creadoPor      String?
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

// Titular de un rol de notificación en una obra (22-10-2026). Un titular por rol
// por obra (índice único parcial (obraId, rolObra)); el usuario debe tener acceso
// (UsuarioObra) a esa obra. Reemplaza el rol que antes vivía en UsuarioObra.
model ObraTitular {
  id             Int       @id @default(autoincrement())
  obraId         Int
  obra           Obra      @relation(fields: [obraId], references: [id])
  rolObra        RolObra
  usuarioId      String
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  creadoEn       DateTime  @default(now())
  creadoPor      String?
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

// Obra — raíz del sistema. Modelo definitivo según Docs/nucleo-compartido.md §4.
model Obra {
  id                   Int        @id @default(autoincrement())
  codigo               String     @unique // identificador interno, obligatorio y único
  nombre               String
  mandante             String?
  direccion            String?
  comuna               String?
  fechaInicio          DateTime?
  fechaTerminoEstimada DateTime?
  estado               EstadoObra @default(SIN_INICIAR)
  usuarios             UsuarioObra[]
  titulares            ObraTitular[]
  lotes                ObraLote[]
  loteUnidades         LoteUnidad[]
  visitas              VisitaTecnica[]
  visitasPrevencion    VisitaPrevencion[]
  respuestas           RespuestaFormulario[]
  // Auditoría completa (nucleo-compartido.md §6 — convención canónica).
  creadoEn             DateTime   @default(now())
  creadoPor            String?
  actualizadoEn        DateTime?  @updatedAt
  actualizadoPor       String?
  eliminadoEn          DateTime?
  eliminadoPor         String?
}

// ─── Catálogos por Área ───────────────────────────────────────────────────
// Catálogos administrables simples (Docs/plan-mantenedores.md §2). Patrón común:
// id, codigo @unique (slug del nombre), nombre, orden, activo, auditoría + soft
// delete. Servidos por el factory shared/catalogo.factory.ts.

// Catálogo de Prevención: severidad de un hallazgo (Alto, Medio, Observación,
// No conformidad). Referenciado a futuro por Hallazgo (módulo prevencion.md).
model NivelRiesgo {
  id           Int       @id @default(autoincrement())
  codigo       String    @unique
  nombre       String
  orden        Int       @default(0)
  activo       Boolean   @default(true)
  hallazgos    HallazgoPrevencion[]
  creadoEn     DateTime  @default(now())
  creadoPor    String?
  eliminadoEn  DateTime?
  eliminadoPor String?
}

// Catálogo de Técnica: tipo de hallazgo técnico (No conformidad, Mejora,
// Sugerencia). Tabla separada de EtapaConstructiva (decisión 06-10-2026).
model TipoHallazgoTecnico {
  id           Int       @id @default(autoincrement())
  codigo       String    @unique
  nombre       String
  orden        Int       @default(0)
  activo       Boolean   @default(true)
  hallazgos    HallazgoTecnico[]
  creadoEn     DateTime  @default(now())
  creadoPor    String?
  eliminadoEn  DateTime?
  eliminadoPor String?
}

// Catálogo de Técnica: etapa constructiva de la obra (Obra gruesa, Faenas
// húmedas, Terminaciones, Especialidades, Urbanización).
model EtapaConstructiva {
  id           Int       @id @default(autoincrement())
  codigo       String    @unique
  nombre       String
  orden        Int       @default(0)
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  creadoPor    String?
  eliminadoEn  DateTime?
  eliminadoPor String?
}

// Catálogo de Técnica: etapas del hito "nido" (6, ordenadas): Descubierto →
// Picado → Buzón → Llenado → Descimbre → Perfilado. `orden` es significativo.
model EtapaNido {
  id           Int       @id @default(autoincrement())
  codigo       String    @unique
  nombre       String
  orden        Int       @default(0)
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  creadoPor    String?
  eliminadoEn  DateTime?
  eliminadoPor String?
}

model CategoriaFormulario {
  id           Int          @id @default(autoincrement())
  areaId       Int
  area         Area         @relation(fields: [areaId], references: [id])
  codigo       String // slug del nombre, único por área (validado en la app)
  nombre       String
  // Campos de mantenedor (ampliación del spec formularios-dinamicos.md §4,
  // 06-10-2026): estado + soft delete + auditoría, aditivos con default.
  activo        Boolean      @default(true)
  formularios   Formulario[]
  subcategorias SubcategoriaFormulario[]
  hallazgosPrevencion HallazgoPrevencion[]
  creadoEn      DateTime     @default(now())
  creadoPor     String?
  eliminadoEn   DateTime?
  eliminadoPor  String?
}

// Nivel anidado bajo CategoriaFormulario (22-10-2026). En Prevención clasifica
// los hallazgos de visita (categoría › subcategoría). Mismos campos que la
// categoría; hereda el Área vía la categoría padre.
model SubcategoriaFormulario {
  id             Int                 @id @default(autoincrement())
  categoriaId    Int
  categoria      CategoriaFormulario @relation(fields: [categoriaId], references: [id])
  codigo         String // slug del nombre, único por categoría (índice parcial WHERE eliminadoEn IS NULL)
  nombre         String
  activo         Boolean             @default(true)
  hallazgos      HallazgoPrevencion[]
  creadoEn       DateTime            @default(now())
  creadoPor      String?
  actualizadoEn  DateTime?           @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

model Formulario {
  id           Int      @id @default(autoincrement())
  codigo       String   @unique
  nombre       String
  areaId       Int
  area         Area     @relation(fields: [areaId], references: [id])
  categoriaId  Int
  categoria    CategoriaFormulario @relation(fields: [categoriaId], references: [id])
  requiereObra Boolean  @default(true)
  activo       Boolean  @default(true)
  preguntas    Pregunta[]
  permisos     FormularioPermiso[]
  procedimientos ProcedimientoFormulario[]
  respuestas   RespuestaFormulario[]
  creadoEn     DateTime @default(now())
  creadoPor    String
  eliminadoEn  DateTime?
}

model Pregunta {
  id              Int      @id @default(autoincrement())
  formularioId    Int
  formulario      Formulario @relation(fields: [formularioId], references: [id])
  orden           Int
  texto           String
  tipoRespuesta   TipoRespuesta
  obligatoria     Boolean  @default(true)
  permiteFoto     Boolean  @default(false)
  // Si permiteFoto, la foto puede además ser obligatoria al responder.
  fotoObligatoria Boolean  @default(false)
  opciones        String[]
  respuestas      RespuestaPregunta[]
}

model RespuestaFormulario {
  id           Int      @id @default(autoincrement())
  formularioId Int
  formulario   Formulario @relation(fields: [formularioId], references: [id])
  obraId       Int
  obra         Obra     @relation(fields: [obraId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  fechaHora    DateTime @default(now())
  respuestas   RespuestaPregunta[]
  creadoEn     DateTime @default(now())
}

model RespuestaPregunta {
  id                     Int      @id @default(autoincrement())
  respuestaFormularioId  Int
  respuestaFormulario    RespuestaFormulario @relation(fields: [respuestaFormularioId], references: [id])
  preguntaId             Int
  pregunta               Pregunta @relation(fields: [preguntaId], references: [id])
  valorTexto             String?
  valorNumero            Decimal?
  valorCheckbox          String?
  valorSeleccionMultiple String[]
  fotoUrl                String?
}

model FormularioPermiso {
  id           Int      @id @default(autoincrement())
  formularioId Int
  formulario   Formulario @relation(fields: [formularioId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  puedeVer     Boolean  @default(true)
  puedeEditar  Boolean  @default(false)

  @@unique([formularioId, usuarioId])
}

// ─── Lotes y Procedimientos (Docs/lotes-procedimientos.md) ──────────────────
// Cadena de trazabilidad: Obra → ObraLote → TipoLote → Procedimiento → Formulario.

// Maestro de tipos de lote (Casa, Departamento, Bodega, Portería, …). Dinámico.
model TipoLote {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique // slug del nombre, único (validado en la app)
  nombre         String
  orden          Int       @default(0)
  activo         Boolean   @default(true)
  procedimientos TipoLoteProcedimiento[]
  obras          ObraLote[]
  unidades       LoteUnidad[]
  creadoEn       DateTime  @default(now())
  creadoPor      String?
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

// Maestro de procedimientos constructivos (PDF normativo). Apunta a formularios
// de control y es referenciado por tipos de lote.
model Procedimiento {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique // identificador del procedimiento, obligatorio y único
  nombre         String
  vigenciaDesde  DateTime            // fecha desde la que rige el documento
  vigenciaHasta  DateTime?           // null = vigente indefinido
  activo         Boolean   @default(true)
  archivo        ProcedimientoArchivo? // PDF adjunto (bytes en BD — ver modelo abajo)
  tiposLote      TipoLoteProcedimiento[]
  formularios    ProcedimientoFormulario[]
  creadoEn       DateTime  @default(now())
  creadoPor      String?
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

// PDF del procedimiento almacenado EN LA BASE DE DATOS (bytea). Tabla separada de
// Procedimiento a propósito: así los listados/detalles del maestro nunca cargan
// el binario en memoria; solo se lee al descargar (Docs/lotes-procedimientos.md §4).
model ProcedimientoArchivo {
  id              Int           @id @default(autoincrement())
  procedimientoId Int           @unique
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id])
  datos           Bytes         // contenido del PDF
  actualizadoEn   DateTime      @updatedAt
}

// Puente M:N  TipoLote ↔ Procedimiento (arista, no entidad de negocio).
model TipoLoteProcedimiento {
  id              Int           @id @default(autoincrement())
  tipoLoteId      Int
  tipoLote        TipoLote      @relation(fields: [tipoLoteId], references: [id])
  procedimientoId Int
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id])
  creadoEn        DateTime      @default(now())
  creadoPor       String?

  @@unique([tipoLoteId, procedimientoId])
}

// Puente M:N  Procedimiento ↔ Formulario de control (arista).
model ProcedimientoFormulario {
  id              Int           @id @default(autoincrement())
  procedimientoId Int
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id])
  formularioId    Int
  formulario      Formulario    @relation(fields: [formularioId], references: [id])
  creadoEn        DateTime      @default(now())
  creadoPor       String?

  @@unique([procedimientoId, formularioId])
}

// Configuración de lotes de una obra — agregado (cantidad por tipo).
model ObraLote {
  id             Int       @id @default(autoincrement())
  obraId         Int
  obra           Obra      @relation(fields: [obraId], references: [id])
  tipoLoteId     Int
  tipoLote       TipoLote  @relation(fields: [tipoLoteId], references: [id])
  cantidad       Int                 // >= 1
  creadoEn       DateTime  @default(now())
  creadoPor      String?
  actualizadoEn  DateTime? @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?

  @@unique([obraId, tipoLoteId])
}

// ─── Visitas Técnicas (Docs/tecnica.md) ─────────────────────────────────────

enum EstadoVisita {
  EN_CURSO
  FINALIZADA
}

enum CalidadImagen {
  ORIGINAL
  OPTIMIZADA
  MEDIA
  BAJA
}

// Tipo de registro de una entrada de visita técnica (tecnica.md §7):
// HALLAZGO exige comentario + foto; NOTA_TECNICA exige comentario, foto opcional.
enum TipoRegistroHallazgo {
  HALLAZGO
  NOTA_TECNICA
}

// Unidad individual de lote, autogenerada desde ObraLote (ej. "Casa 001").
model LoteUnidad {
  id          Int       @id @default(autoincrement())
  obraId      Int
  obra        Obra      @relation(fields: [obraId], references: [id])
  tipoLoteId  Int
  tipoLote    TipoLote  @relation(fields: [tipoLoteId], references: [id])
  correlativo Int
  descripcion String
  hallazgos   HallazgoTecnico[]
  creadoEn    DateTime  @default(now())
  eliminadoEn DateTime?

  @@unique([obraId, tipoLoteId, correlativo])
}

model VisitaTecnica {
  id             Int          @id @default(autoincrement())
  obraId         Int
  obra           Obra         @relation(fields: [obraId], references: [id])
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  fecha          DateTime
  horaInicio     String?
  horaTermino    String?
  estado         EstadoVisita @default(EN_CURSO)
  resumenFinal   String?
  hallazgos      HallazgoTecnico[]
  creadoEn       DateTime     @default(now())
  creadoPor      String?
  actualizadoEn  DateTime?    @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

model HallazgoTecnico {
  id             Int                 @id @default(autoincrement())
  visitaId       Int
  visita         VisitaTecnica       @relation(fields: [visitaId], references: [id])
  loteUnidadId   Int
  loteUnidad     LoteUnidad          @relation(fields: [loteUnidadId], references: [id])
  // tipoRegistro clasifica la entrada; tipoHallazgo (catálogo) solo aplica a HALLAZGO.
  tipoRegistro   TipoRegistroHallazgo @default(HALLAZGO)
  tipoHallazgoId Int?
  tipoHallazgo   TipoHallazgoTecnico? @relation(fields: [tipoHallazgoId], references: [id])
  comentario     String?
  orden          Int                 @default(0)
  fotos          HallazgoFoto[]
  creadoEn       DateTime            @default(now())
  eliminadoEn    DateTime?
}

// Metadata de la foto (sin el binario → no se arrastra en listados).
model HallazgoFoto {
  id          Int             @id @default(autoincrement())
  hallazgoId  Int
  hallazgo    HallazgoTecnico @relation(fields: [hallazgoId], references: [id])
  mimetype    String
  calidad     CalidadImagen
  tamano      Int
  ancho       Int?
  alto        Int?
  orden       Int             @default(0)
  data        HallazgoFotoData?
  creadoEn    DateTime        @default(now())
}

// Binario de la foto EN LA BD (bytea), tabla separada (patrón PDF procedimientos).
model HallazgoFotoData {
  id     Int          @id @default(autoincrement())
  fotoId Int          @unique
  foto   HallazgoFoto @relation(fields: [fotoId], references: [id])
  datos  Bytes
}

// ─── Visitas de Prevención (Docs/prevencion.md, Ola 2) ──────────────────────
// Calcado de Visitas Técnicas (reusa EstadoVisita/CalidadImagen), con diferencias:
// SIN lote; clasificación Categoría › Subcategoría + NivelRiesgo; plazo de solución
// (valor + días/horas); histórico sin ciclo "por resolver".

enum PlazoUnidad {
  DIAS
  HORAS
}

model VisitaPrevencion {
  id             Int          @id @default(autoincrement())
  obraId         Int
  obra           Obra         @relation(fields: [obraId], references: [id])
  usuarioId      String
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  fecha          DateTime
  horaInicio     String?
  horaTermino    String?
  estado         EstadoVisita @default(EN_CURSO)
  resumenFinal   String?
  hallazgos      HallazgoPrevencion[]
  creadoEn       DateTime     @default(now())
  creadoPor      String?
  actualizadoEn  DateTime?    @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

model HallazgoPrevencion {
  id             Int                    @id @default(autoincrement())
  visitaId       Int
  visita         VisitaPrevencion       @relation(fields: [visitaId], references: [id])
  categoriaId    Int
  categoria      CategoriaFormulario    @relation(fields: [categoriaId], references: [id])
  subcategoriaId Int
  subcategoria   SubcategoriaFormulario @relation(fields: [subcategoriaId], references: [id])
  nivelRiesgoId  Int
  nivelRiesgo    NivelRiesgo            @relation(fields: [nivelRiesgoId], references: [id])
  plazoValor     Int                    // tiempo estimado de solución (> 0)
  plazoUnidad    PlazoUnidad
  comentario     String                 // obligatorio
  orden          Int                    @default(0)
  fotos          HallazgoPrevencionFoto[]
  // Auditoría completa (nucleo-compartido.md §6 — tabla nueva, QA-OKA-019).
  creadoEn       DateTime               @default(now())
  creadoPor      String?
  actualizadoEn  DateTime?              @updatedAt
  actualizadoPor String?
  eliminadoEn    DateTime?
  eliminadoPor   String?
}

// Metadata de la foto (sin el binario → no se arrastra en listados).
model HallazgoPrevencionFoto {
  id         Int                 @id @default(autoincrement())
  hallazgoId Int
  hallazgo   HallazgoPrevencion  @relation(fields: [hallazgoId], references: [id])
  mimetype   String
  calidad    CalidadImagen
  tamano     Int
  ancho      Int?
  alto       Int?
  orden      Int                 @default(0)
  data       HallazgoPrevencionFotoData?
  creadoEn   DateTime            @default(now())
}

// Binario de la foto EN LA BD (bytea), tabla separada (patrón de técnica).
model HallazgoPrevencionFotoData {
  id     Int                    @id @default(autoincrement())
  fotoId Int                    @unique
  foto   HallazgoPrevencionFoto @relation(fields: [fotoId], references: [id])
  datos  Bytes
}

// Configuración del sistema (clave/valor). 1er uso: calidad de imagen por defecto.
model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String
}
